@using Revathryn.Resources
@model Revathryn.Models.Issues.IssueRepositoryListViewModel
@{
    ViewData["Title"] = Strings.BrowseIssuesTitle;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">@Strings.BrowseIssuesTitle</h1>
        <p class="text-muted mb-0">@Strings.BrowseIssuesInstruction</p>
    </div>
</div>

@if (Model.Repositories.Count == 0)
{
    <div class="alert alert-secondary">
        @Strings.NoRepositories
    </div>
}
else
{
    <div class="list-group">
        @foreach (Revathryn.Models.Issues.IssueRepositoryListItemViewModel item in Model.Repositories)
        {
            <div class="list-group-item">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <a asp-action="List" asp-route-id="@item.Repository.Id" class="fw-semibold text-decoration-none">@item.Repository.Name</a>

                            @if (item.Repository.Enabled)
                            {
                                <span class="badge bg-success">@Strings.RepositoryEnabled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Strings.RepositoryDisabled</span>
                            }
                        </div>

                        <div class="text-muted small text-truncate" title="@item.Repository.LocalPath">
                            @Strings.RepositoryLocationLabel: @item.Repository.LocalPath
                        </div>

                        <div class="text-muted small mt-1">
                            @Strings.LastScanLabel:
                            @if (item.Repository.LastSuccessfulScanDate is null)
                            {
                                <span>@Strings.NeverScannedLabel</span>
                            }
                            else
                            {
                                <span>@item.Repository.LastSuccessfulScanDate.Value.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                            }
                        </div>
                    </div>

                    <div class="d-flex flex-column align-items-end gap-2">
                        <span class="badge bg-primary">
                            @Strings.TotalIssuesLabel: @item.IssueCount
                        </span>
                        <a asp-action="List" asp-route-id="@item.Repository.Id" class="btn btn-outline-primary btn-sm">@Strings.IssuesTitle</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
