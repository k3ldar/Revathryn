@using Revathryn.Resources
@model Revathryn.Models.Administration.ReviewTypeListViewModel
@{
    ViewData["Title"] = Strings.ReviewTypesLabel;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@Strings.ReviewTypesLabel</h1>
    <a asp-action="CreateReviewType" class="btn btn-primary">@Strings.AddReviewTypeButton</a>
</div>

<form asp-action="ReviewTypes" method="get" class="mb-3" id="reviewTypeFilterForm">
    <div class="row g-2 align-items-center">
        <div class="col-auto">
            <label for="repositoryFilter" class="form-label mb-0">@Strings.RepositoryLabel</label>
        </div>
        <div class="col-auto">
            <select id="repositoryFilter" name="repositoryId" class="form-select" onchange="this.form.submit()">
                <option value="">@Strings.AllRepositoriesLabel</option>

                @foreach (Revathryn.Contracts.Models.Repository repository in Model.Repositories)
                {
                    if (Model.SelectedRepositoryId == repository.Id)
                    {
                        <option value="@repository.Id" selected="selected">@repository.Name</option>
                    }
                    else
                    {
                        <option value="@repository.Id">@repository.Name</option>
                    }
                }
            </select>
        </div>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-secondary">
        @Strings.NoReviewTypesMessage
    </div>
}
else
{
    <div class="list-group">
        @foreach (Revathryn.Models.Administration.ReviewTypeListItemViewModel item in Model.Items)
        {
            <div class="list-group-item">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="fw-semibold">@item.ReviewType.Name</span>
                            <span class="badge bg-info text-dark">@item.RepositoryName</span>

                            @if (item.ReviewType.Enabled)
                            {
                                <span class="badge bg-success">@Strings.EnabledLabel</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Strings.RepositoryDisabled</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.ReviewType.Description))
                        {
                            <div class="text-muted small">@item.ReviewType.Description</div>
                        }

                        <div class="text-muted small">
                            @Strings.FileExtensionsLabel: @(string.IsNullOrWhiteSpace(item.ReviewType.FileExtensions) ? Strings.AllFilesLabel : item.ReviewType.FileExtensions)
                            ·
                            @Strings.PriorityLabel: @item.ReviewType.DefaultPriority
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="EditReviewType" asp-route-id="@item.ReviewType.Id" class="btn btn-outline-secondary btn-sm">@Strings.EditButton</a>
                        <a asp-action="DeleteReviewType" asp-route-id="@item.ReviewType.Id" class="btn btn-outline-danger btn-sm">@Strings.DeleteButton</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
