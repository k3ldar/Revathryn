@using Revathryn.Resources
@model Revathryn.Models.Administration.ReviewTypeListViewModel
@{
    ViewData["Title"] = Strings.ReviewTypesLabel;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@Strings.ReviewTypesLabel</h1>
    <a asp-action="CreateReviewType" class="btn btn-primary">@Strings.AddReviewTypeButton</a>
</div>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-secondary">
        @Strings.NoReviewTypesMessage
    </div>
}
else
{
    <div class="list-group">
        @foreach (Revathryn.Models.Administration.ReviewTypeListItemViewModel item in Model.Items)
        {
            <div class="list-group-item">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div class="flex-grow-1">
                        <div class="fw-semibold">@item.ReviewType.Name</div>

                        @if (!string.IsNullOrWhiteSpace(item.ReviewType.Description))
                        {
                            <div class="text-muted small">@item.ReviewType.Description</div>
                        }

                        <div class="text-muted small">
                            @Strings.FileExtensionsLabel: @(string.IsNullOrWhiteSpace(item.ReviewType.FileExtensions) ? Strings.AllFilesLabel : item.ReviewType.FileExtensions)
                            ·
                            @Strings.PriorityLabel: @item.ReviewType.DefaultPriority
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="EditReviewType" asp-route-id="@item.ReviewType.Id" class="btn btn-outline-secondary btn-sm">@Strings.EditButton</a>
                        <a asp-action="DeleteReviewType" asp-route-id="@item.ReviewType.Id" class="btn btn-outline-danger btn-sm">@Strings.DeleteButton</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
