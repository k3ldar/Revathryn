@using Revathryn.Resources
@model Revathryn.Contracts.Models.AIEngine
@{
    ViewData["Title"] = Strings.DeleteButton;
}

<h1>@Strings.DeleteButton</h1>

<div class="alert alert-danger">
    @string.Format(Strings.EngineDeleteConfirmation, Model.Name)
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Strings.EngineNameLabel</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">@Strings.ProviderLabel</dt>
            <dd class="col-sm-9">@Model.Provider</dd>

            <dt class="col-sm-3">@Strings.ModelLabel</dt>
            <dd class="col-sm-9">@Model.Model</dd>
        </dl>
    </div>
</div>

<form asp-action="DeleteEngine" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">@Strings.DeleteButton</button>
        <a asp-action="Engines" class="btn btn-outline-secondary">@Strings.CancelButton</a>
    </div>
</form>
