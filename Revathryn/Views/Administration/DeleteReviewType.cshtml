@using Revathryn.Resources
@model Revathryn.Contracts.Models.ReviewType
@{
    ViewData["Title"] = Strings.DeleteButton;
}

<h1>@Strings.DeleteButton</h1>

<div class="alert alert-danger">
    @string.Format(Strings.ReviewTypeDeleteConfirmation, Model.Name)
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Strings.NameLabel</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">@Strings.DescriptionLabel</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">@Strings.FileExtensionsLabel</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.FileExtensions) ? Strings.AllFilesLabel : Model.FileExtensions)</dd>

            <dt class="col-sm-3">@Strings.PriorityLabel</dt>
            <dd class="col-sm-9">@Model.DefaultPriority</dd>
        </dl>
    </div>
</div>

<form asp-action="DeleteReviewType" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">@Strings.DeleteButton</button>
        <a asp-action="ReviewTypes" class="btn btn-outline-secondary">@Strings.CancelButton</a>
    </div>
</form>
