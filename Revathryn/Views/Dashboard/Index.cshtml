@using Revathryn.Contracts.Models
@using Revathryn.Resources
@model Revathryn.Contracts.Models.DashboardSnapshot
@{
    ViewData["Title"] = Strings.DashboardTitle;
    ViewData["Breadcrumbs"] = new List<Revathryn.Models.BreadcrumbItem>
    {
        new() { Title = Strings.DashboardTitle, IsActive = true }
    };
}

<h1>@Strings.DashboardTitle</h1>
<p class="lead">@Strings.DashboardWelcome</p>

<div id="dashboardContent">
    <partial name="@Revathryn.Contracts.Consts.DashboardContentViewName" model="Model" />
</div>

@section Scripts
{
    <script>
        (function () {
            const refreshUrl = '@Url.Action(Revathryn.Contracts.Consts.DashboardDataActionName, Revathryn.Contracts.Consts.DashboardControllerName)';
            const refreshInterval = @Revathryn.Contracts.Consts.DashboardRefreshIntervalMilliseconds;
            const contentElement = document.getElementById('dashboardContent');
            let refreshing = false;

            function refreshDashboard() {
                window.setTimeout(refreshDashboard, refreshInterval);

                if (document.hidden || refreshing) {
                    return;
                }

                refreshing = true;
                $.get(refreshUrl)
                    .done(function (html) {
                        contentElement.innerHTML = html;
                    })
                    .always(function () {
                        refreshing = false;
                    });
            }

            refreshDashboard();
        })();
    </script>
}