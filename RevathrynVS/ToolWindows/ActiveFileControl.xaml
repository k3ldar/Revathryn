<UserControl
    x:Class="RevathrynVS2026.ToolWindows.ActiveFileControl"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:local="clr-namespace:RevathrynVS2026.ToolWindows"
    xmlns:details="clr-namespace:RevathrynVS2026.Details"
    AutomationProperties.AutomationId="ActiveFileControl"
    Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" />
        </Style>

        <Style x:Key="SeverityBadge" TargetType="Border">
            <Setter Property="Background" Value="#6B7280" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static details:IssueSeverity.Low}">
                    <Setter Property="Background" Value="#2D7DD2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static details:IssueSeverity.Medium}">
                    <Setter Property="Background" Value="#B87503" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static details:IssueSeverity.High}">
                    <Setter Property="Background" Value="#D9531E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static details:IssueSeverity.Critical}">
                    <Setter Property="Background" Value="#B00020" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IssueCard" TargetType="Border">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ActiveBorderKey}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsClosed}" Value="True">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            AutomationProperties.AutomationId="FilePathText"
            Text="{Binding FilePath}"
            TextTrimming="CharacterEllipsis"
            ToolTip="{Binding FilePath}"
            VerticalAlignment="Center" />

        <Button
            Grid.Row="0"
            Grid.Column="1"
            Margin="8,0,0,0"
            Padding="8,2"
            AutomationProperties.AutomationId="RefreshButton"
            Click="OnRefreshClicked"
            Content="Refresh" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,4,0,4"
            AutomationProperties.AutomationId="StatusText"
            Opacity="0.75"
            Text="{Binding StatusText}"
            TextWrapping="Wrap" />

        <TreeView
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            AutomationProperties.AutomationId="JsonTree"
            Background="Transparent"
            BorderThickness="0"
            Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
            ItemsSource="{Binding Nodes}"
            Visibility="{Binding ShowNodes, Converter={StaticResource BoolToVisibility}}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:JsonNodeViewModel}" ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding DisplayText}" />
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <ScrollViewer
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            AutomationProperties.AutomationId="DetailsScroll"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DataContext="{Binding Details}">
                <TextBlock
                    AutomationProperties.AutomationId="DetailsFileName"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{Binding FileName}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Opacity="0.75"
                    Text="{Binding LocationText}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Opacity="0.75"
                    Text="{Binding LastScanText}"
                    TextWrapping="Wrap" />

                <ItemsControl
                    Margin="0,8,0,0"
                    AutomationProperties.AutomationId="NoticeList"
                    ItemsSource="{Binding Notices}"
                    Visibility="{Binding HasNotices, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,4"
                                Padding="8,4"
                                BorderBrush="#B87503"
                                BorderThickness="3,0,0,0">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander
                    AutomationProperties.AutomationId="ArchitectureSection"
                    Header="Architecture"
                    IsExpanded="True"
                    Style="{StaticResource SectionExpander}"
                    Visibility="{Binding HasArchitecture, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="16,4,0,0">
                        <TextBlock
                            Margin="0,0,0,4"
                            Opacity="0.75"
                            Text="{Binding ArchitectureCaption}"
                            TextWrapping="Wrap" />
                        <local:MarkdownTextBlock Markdown="{Binding ArchitectureSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander
                    AutomationProperties.AutomationId="IssuesSection"
                    Header="{Binding IssuesHeader}"
                    IsExpanded="True"
                    Style="{StaticResource SectionExpander}">
                    <ItemsControl
                        Margin="16,0,0,0"
                        AutomationProperties.AutomationId="IssueList"
                        ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type details:IssueViewModel}">
                                <Border Style="{StaticResource IssueCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button
                                                Padding="8,2"
                                                AutomationProperties.AutomationId="GoToLineButton"
                                                Command="{Binding GoToLineCommand}"
                                                Content="Go to line"
                                                DockPanel.Dock="Right"
                                                VerticalAlignment="Top" />
                                            <Border DockPanel.Dock="Left" Style="{StaticResource SeverityBadge}">
                                                <TextBlock
                                                    Foreground="White"
                                                    Text="{Binding SeverityText}" />
                                            </Border>
                                            <TextBlock
                                                Margin="8,0"
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Opacity="0.75"
                                            Text="{Binding MetaText}"
                                            TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock
                                                Margin="0,0,6,0"
                                                Opacity="0.75"
                                                Text="Severity"
                                                VerticalAlignment="Center" />
                                            <ComboBox
                                                Width="110"
                                                Margin="0,0,12,0"
                                                AutomationProperties.AutomationId="SeverityCombo"
                                                DisplayMemberPath="Display"
                                                ItemsSource="{Binding SeverityOptions}"
                                                SelectedValue="{Binding SelectedSeverity, Mode=TwoWay}"
                                                SelectedValuePath="Value" />
                                            <TextBlock
                                                Margin="0,0,6,0"
                                                Opacity="0.75"
                                                Text="Status"
                                                VerticalAlignment="Center" />
                                            <ComboBox
                                                Width="120"
                                                Margin="0,0,12,0"
                                                AutomationProperties.AutomationId="StatusCombo"
                                                DisplayMemberPath="Display"
                                                ItemsSource="{Binding StatusOptions}"
                                                SelectedValue="{Binding SelectedStatus, Mode=TwoWay}"
                                                SelectedValuePath="Value" />
                                            <Button
                                                Margin="0,0,8,0"
                                                Padding="8,2"
                                                AutomationProperties.AutomationId="ResubmitButton"
                                                Command="{Binding ResubmitCommand}"
                                                Content="Resubmit" />
                                            <Button
                                                Padding="8,2"
                                                AutomationProperties.AutomationId="ViewOnlineButton"
                                                Command="{Binding ViewOnlineCommand}"
                                                Content="View online" />
                                        </WrapPanel>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Visibility="{Binding HasSuggestedFix, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                FontWeight="SemiBold"
                                                Text="Suggested fix" />
                                            <TextBlock Text="{Binding SuggestedFix}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander
                    AutomationProperties.AutomationId="ReviewsSection"
                    Header="{Binding ReviewsSummary}"
                    Style="{StaticResource SectionExpander}"
                    Visibility="{Binding HasReviews, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl
                        Margin="16,4,0,0"
                        ItemsSource="{Binding Reviews}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type details:ReviewViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Opacity="0.75"
                                        Text="{Binding StatusText}"
                                        ToolTip="{Binding AnalysedText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander
                    AutomationProperties.AutomationId="SystemDependenciesSection"
                    Header="{Binding SystemDependenciesHeader}"
                    IsExpanded="True"
                    Style="{StaticResource SectionExpander}"
                    Visibility="{Binding HasSystemDependencies, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl
                        Margin="16,4,0,0"
                        MaxHeight="320"
                        AutomationProperties.AutomationId="SystemDependenciesList"
                        ItemsSource="{Binding SystemDependencies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander
                    AutomationProperties.AutomationId="OtherDependenciesSection"
                    Header="{Binding OtherDependenciesHeader}"
                    IsExpanded="True"
                    Style="{StaticResource SectionExpander}"
                    Visibility="{Binding HasOtherDependencies, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl
                        Margin="16,4,0,0"
                        MaxHeight="320"
                        AutomationProperties.AutomationId="OtherDependenciesList"
                        ItemsSource="{Binding OtherDependencies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
