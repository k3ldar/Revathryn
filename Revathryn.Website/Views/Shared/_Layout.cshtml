@using Revathryn.Website.Models
@inject WebsiteSettings Site
@{
    string pageTitle = ViewData["Title"] as string;
    string fullTitle = string.IsNullOrWhiteSpace(pageTitle) ? Site.WebsiteTitle : pageTitle + " · " + Site.ProjectName;
    string description = ViewData["Description"] as string ?? Site.WebsiteDescription;
    string canonicalPath = ViewData["CanonicalPath"] as string ?? "/";
    string canonicalUrl = Site.SiteBaseUrl.TrimEnd('/') + canonicalPath;
    string currentController = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
    string currentAction = ViewContext.RouteData.Values["action"] as string ?? string.Empty;
    int currentYear = DateTime.UtcNow.Year;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@Site.ProjectName" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg site-navbar fixed-top" aria-label="Primary navigation">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">&lt;/&gt;</span> @Site.ProjectName
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#siteNavigation" aria-controls="siteNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="siteNavigation">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : null)" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Roadmap" ? "active" : null)" asp-controller="Roadmap" asp-action="Index">Roadmap</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "About" ? "active" : null)" asp-controller="About" asp-action="Index">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Documentation" ? "active" : null)" asp-controller="Documentation" asp-action="Index">Documentation</a>
                        </li>
                        @if (!string.IsNullOrWhiteSpace(Site.GitHubRepositoryUrl))
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="btn btn-outline-accent btn-sm" href="@Site.GitHubRepositoryUrl" target="_blank" rel="noopener">GitHub</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4 py-5">
                <div class="col-lg-5">
                    <span class="footer-brand"><span class="brand-mark" aria-hidden="true">&lt;/&gt;</span> @Site.ProjectName</span>
                    <p class="footer-tagline mt-3 mb-0">@Site.WebsiteDescription</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h2 class="footer-heading">Project</h2>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Roadmap" asp-action="Index">Roadmap</a></li>
                        <li><a asp-controller="About" asp-action="Index">About</a></li>
                        <li><a asp-controller="Documentation" asp-action="Index">Documentation</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h2 class="footer-heading">Community</h2>
                    <ul class="footer-links">
                        @if (!string.IsNullOrWhiteSpace(Site.GitHubRepositoryUrl))
                        {
                            <li><a href="@Site.GitHubRepositoryUrl" target="_blank" rel="noopener">GitHub</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Site.GitHubIssuesUrl))
                        {
                            <li><a href="@Site.GitHubIssuesUrl" target="_blank" rel="noopener">Issues</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Site.GitHubDiscussionsUrl))
                        {
                            <li><a href="@Site.GitHubDiscussionsUrl" target="_blank" rel="noopener">Discussions</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Site.LicenceUrl))
                        {
                            <li><a href="@Site.LicenceUrl" target="_blank" rel="noopener">Licence</a></li>
                        }
                    </ul>
                </div>
                @if (!string.IsNullOrWhiteSpace(Site.ContactEmail))
                {
                    <div class="col-6 col-lg-3">
                        <h2 class="footer-heading">Contact</h2>
                        <ul class="footer-links">
                            <li><a href="mailto:@Site.ContactEmail">@Site.ContactEmail</a></li>
                        </ul>
                    </div>
                }
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container d-flex flex-wrap justify-content-between gap-2">
                <span>&copy; @currentYear @Site.ProjectName</span>
                <span>Repository intelligence. Deeper understanding. Better software.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
